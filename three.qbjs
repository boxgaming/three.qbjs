Function LoadTexture(path, onLoad)
$If Javascript Then
    var loader = new __THREE.TextureLoader();
    var texture = loader.load(path, onLoad);
    texture.colorSpace = __THREE.SRGBColorSpace;
    return await func_RegisterObject(texture);
$End If
End Function

Function WebGLRenderer (opts, embedded)
    Dim renderer As Object
    If embedded = undefined Then embedded = -1
$If Javascript Then
    renderer = await func_RegisterObject(new __THREE.WebGLRenderer(opts));
$End If
    embeddedMode = embedded
    renderer.domElement.className = "qbjs-3js-canvas"
    renderCanvas = renderer.domElement
    If embeddedMode Then
        renderer.domElement.style.display = "none"
    End If
    'Dom.Add renderer.domElement', Dom.Container
$If Javascript Then
    document.getElementById("gx-container").appendChild(renderer.domElement);
$End If
    WebGLRenderer = renderer
End Function

